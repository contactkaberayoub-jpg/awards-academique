# ============================================================
# Awards Academique - Backend environment template
# Copy to .env.bat (Windows) / export as OS variables (Linux/Mac)
# and fill real values. NEVER commit real secrets.
# ============================================================

# --- Database (PostgreSQL / Supabase pooler) ---
DATABASE_URL=jdbc:postgresql://HOST:PORT/database?sslmode=require
DATABASE_USERNAME=change-me
DATABASE_PASSWORD=change-me

# --- Security (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=3600000

# --- CORS (comma-separated frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
SERVER_PORT=8080

# --- E-mail (Gmail SMTP - primary provider, used by RoutingEmailService) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@gmail.com
MAIL_APP_PASSWORD=change-me-16-char-app-password

# --- E-mail (Resend - optional fallback provider) ---
RESEND_API_KEY=
RESEND_FROM=awards@resend.dev

# --- Frontend URL (base used to build e-mail links) ---
FRONTEND_URL=http://localhost:5173

# --- E-mail token lifetimes ---
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- PayPal ---
PAYPAL_CLIENT_ID=change-me
PAYPAL_CLIENT_SECRET=change-me
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# --- Google OAuth ---
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/google/callback

# --- AI Tutor (Gemini via OpenAI-compatible endpoint) ---
AI_API_KEY=change-me
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TUTOR_MODEL=gemini-3.6-flash

# --- Lesson video uploads ---
LESSON_VIDEO_MAX_SIZE=500MB
LESSON_VIDEO_STORAGE_DIRECTORY=uploads/lesson-videos
LESSON_VIDEO_MAX_SIZE_BYTES=524288000