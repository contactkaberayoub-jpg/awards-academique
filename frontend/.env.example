# ============================================================
# Awards Academique - Frontend environment template
# Copy to .env (or .env.local for local dev) and fill real values.
# NEVER commit real secrets. VITE_* vars are embedded in the
# public bundle - never put secret values here.
# ============================================================

# Base URL of the Spring Boot backend (publicly reachable in deployment)
VITE_API_BASE_URL=http://localhost:8080/api

# PayPal client ID (public; sandbox for development, live for production)
VITE_PAYPAL_CLIENT_ID=

# Legacy Supabase references (optional; not used by the current backend client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=